<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            style="@style/Heading"
            android:text="@string/app_name" />

        <TextView
            style="@style/Hint"
            android:text="@string/main_intro" />

        <TextView
            android:id="@+id/textOverlay"
            style="@style/Hint"
            android:layout_marginTop="12dp" />

        <Button
            android:id="@+id/btnOverlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/overlay_grant" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchCluster"
            style="@style/Switch"
            android:text="@string/settings_cluster" />

        <TextView
            style="@style/Hint"
            android:text="@string/settings_cluster_hint" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchWheelKeys"
            style="@style/Switch"
            android:text="@string/settings_wheel_keys" />

        <TextView
            style="@style/Hint"
            android:text="@string/settings_wheel_keys_hint" />

        <TextView
            android:id="@+id/textWheelStatus"
            style="@style/Hint" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchMuteMedia"
            style="@style/Switch"
            android:layout_marginStart="16dp"
            android:text="@string/settings_mute_media" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchHoldVolume"
            style="@style/Switch"
            android:layout_marginStart="16dp"
            android:text="@string/settings_hold_volume" />

        <TextView
            style="@style/Hint"
            android:layout_marginStart="16dp"
            android:text="@string/settings_hold_volume_hint" />

        <TextView
            style="@style/Heading"
            android:layout_marginTop="24dp"
            android:text="@string/test_title" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnTestInfo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/test_info" />

            <Button
                android:id="@+id/btnTestQuestion"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:layout_weight="1"
                android:text="@string/test_question" />

            <Button
                android:id="@+id/btnTestList"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/test_list" />
        </LinearLayout>

        <TextView
            style="@style/Hint"
            android:text="@string/test_hint" />

        <TextView
            style="@style/Heading"
            android:layout_marginTop="24dp"
            android:text="@string/diag_title" />

        <Button
            android:id="@+id/btnKeyLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/diag_key_log_start" />

        <Button
            android:id="@+id/btnVolumeTrace"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/diag_volume_trace" />

        <TextView
            style="@style/Hint"
            android:text="@string/diag_volume_trace_hint" />

        <Button
            android:id="@+id/btnSendLogs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/logs_send" />

        <TextView
            android:id="@+id/textDiag"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="monospace"
            android:textColor="@color/text_primary"
            android:textIsSelectable="true"
            android:textSize="13sp" />

        <TextView
            style="@style/Heading"
            android:layout_marginTop="24dp"
            android:text="@string/settings_log_server" />

        <TextView
            style="@style/Hint"
            android:text="@string/settings_log_server_hint" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/settings_log_url">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editLogUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textUri"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/settings_log_user">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editLogUser"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/settings_log_password"
            app:endIconMode="password_toggle">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editLogPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>
</ScrollView>
